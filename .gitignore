# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Slurm logs
slurm-*.out
slurm/logs/

# Conda environments, caches and model weights (live on Hellbender, never in the repo)
/envs/
.conda/
hf_cache/
.cache/
colabfold_weights/
params/
*.npz
*.ckpt
*.pt
*.safetensors

# Large prediction intermediates
*.pkl
*.pickle
*.tar.gz
*.zip

# Scratch
tmp_*/
data/downloads/

# ColabFold score files of models ranked 2-5 (they include full PAE matrices).
# They stay on disk; their pLDDT/pTM/time are copied into each summary.json.
results/**/*_scores_rank_00[2-5]_*.json

# Domain-trimmed copies of predictions made by the evaluate step (rebuilt on every run)
results/**/eval/

# Slurm job bookkeeping of pipeline.py
results/**/.jobs/
